{
  "name": "Bot-Hoven",
  "dockerFile": "Dockerfile",
  "runArgs": [
    "--privileged",
    "--network=host",
    "-e",
    "DISPLAY=${localEnv:DISPLAY}",
    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix",
    // "-v",
    // "/sys/class/gpio:/sys/class/gpio",
    "-v",
    "/dev:/dev",
    "--cap-add=sys_nice",
    "--ulimit",
    "memlock=-1:-1",
    "--ulimit",
    "rtprio=99"
  ],
  "postCreateCommand": "/bin/bash -c 'for dev in /dev/i2c-1 ; do if [ -e $dev ]; then sudo chown :i2c $dev && sudo chmod g+rw $dev; fi; done && if [ -e /dev/spidev0.0 ]; then sudo chown :spi /dev/spidev0.0 && sudo chmod g+rw /dev/spidev0.0; fi'",
  "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.bash_history,target=/home/ubuntu/.bash_history,type=bind",
    "source=bothoven-devcontainer-bashhistory,target=/commandhistory,type=volume",
    {
      "source": "/etc/localtime",
      "target": "/etc/localtime",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "smilerobotics.urdf",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack",
        "redhat.vscode-xml",
        "GitHub.copilot"
      ]
    }
  }
}