  <ros2_control is_async="false" name="left_stepper_driver" type="system">
    <hardware>
      <plugin>cl42t_hardware_interface/Cl42tSystemHardware</plugin>
      <param name="spi_device">/dev/spidev0.0</param>
      <param name="spi_mode">1</param>
      <param name="bus_speed_hz">1000000</param>
      <param name="bits_per_word">8</param>
      <param name="stepper_side">l</param>
    </hardware>
    <joint name="lh_stepper">
      <command_interface name="position">
        <param name="min">-0.30960000000000004</param>
        <param name="max">0.7063999999999999</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
  <ros2_control is_async="false" name="right_stepper_driver" type="system">
    <hardware>
      <plugin>cl42t_hardware_interface/Cl42tSystemHardware</plugin>
      <param name="spi_device">/dev/spidev0.0</param>
      <param name="spi_mode">1</param>
      <param name="bus_speed_hz">1000000</param>
      <param name="bits_per_word">8</param>
      <param name="stepper_side">r</param>
    </hardware>
    <joint name="rh_stepper">
      <command_interface name="position">
        <param name="min">-0.7063999999999999</param>
        <param name="max">0.30960000000000004</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
  <ros2_control name="left_servo_driver" type="system">
    <hardware>
      <plugin>pca9685_hardware_interface/Pca9685SystemHardware</plugin>
      <param name="i2c_device">/dev/i2c-1</param>
      <param name="pca_frequency_hz">50</param>
      <param name="pca_i2c_address">64</param>
      <param name="min_duty_cycle_ms">0.5</param>
      <param name="max_duty_cycle_ms">2.5</param>
      <param name="ads_i2c_address">16</param>
      <!-- 0x10 -->
      <param name="ads_conversion_rate">20</param>
      <!-- 20 kSPS -->
    </hardware>
    <!-- thumb -->
    <joint name="lh_servo_1">
      <command_interface name="position">
        <param name="min">-0.08726646259971647</param>
        <param name="max">0.08726646259971647</param>
      </command_interface>
      <state_interface name="position"/>
      <!-- PCA9685 parameters -->
      <param name="servo_channel">4</param>
      <param name="pwm_min">500</param>
      <param name="pwm_max">2500</param>
      <param name="pwm_slope">13.10</param>
      <param name="pwm_intercept">339.41</param>
      <!-- ADS7138 parameters -->
      <param name="adc_channel">4</param>
      <param name="adc_slope">2.33</param>
      <param name="adc_intercept">91.48</param>
    </joint>
    <!-- index -->
    <joint name="lh_servo_2">
      <command_interface name="position">
        <param name="min">-0.08726646259971647</param>
        <param name="max">0.08726646259971647</param>
      </command_interface>
      <state_interface name="position"/>
      <!-- PCA9685 parameters -->
      <param name="servo_channel">3</param>
      <param name="pwm_min">500</param>
