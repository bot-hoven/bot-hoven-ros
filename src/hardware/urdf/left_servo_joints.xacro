<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <joint name="lh_servo_1">
        <command_interface name="position">
            <param name="min">${servo_min}</param>
            <param name="max">${servo_max}</param>
        </command_interface>
        <state_interface name="position" />
    </joint>
    <joint name="lh_servo_2">
        <command_interface name="position">
            <param name="min">${servo_min}</param>
            <param name="max">${servo_max}</param>
        </command_interface>
        <state_interface name="position" />
    </joint>
