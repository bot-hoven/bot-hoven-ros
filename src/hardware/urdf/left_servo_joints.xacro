        </command_interface>
        <state_interface name="position" />
    </joint>
    <joint name="lh_servo_4">
        <command_interface name="position">
            <param name="min">${servo_min}</param>
            <param name="max">${servo_max}</param>
        </command_interface>
        <state_interface name="position" />
    </joint>
    <joint name="lh_servo_5">
        <command_interface name="position">
            <param name="min">${servo_min}</param>
