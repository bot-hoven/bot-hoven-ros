<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- thumb -->
    <joint name="lh_solenoid_1">
        <command_interface name="position">
            <param name="min">${solenoid_min}</param>
            <param name="max">${solenoid_max}</param>
        </command_interface>
        <state_interface name="position" />
        <param name="solenoid_channel">4</param>
    </joint>
    
    <!-- index -->
    <joint name="lh_solenoid_2">
        <command_interface name="position">
            <param name="min">${solenoid_min}</param>
            <param name="max">${solenoid_max}</param>
        </command_interface>
        <state_interface name="position" />
        <param name="solenoid_channel">3</param>
    </joint>
    
    <!-- middle -->
    <joint name="lh_solenoid_3">
        <command_interface name="position">
            <param name="min">${solenoid_min}</param>
            <param name="max">${solenoid_max}</param>
        </command_interface>
        <state_interface name="position" />
        <param name="solenoid_channel">2</param>
    </joint>
    
    <!-- ring -->
    <joint name="lh_solenoid_4">
        <command_interface name="position">
            <param name="min">${solenoid_min}</param>
            <param name="max">${solenoid_max}</param>
        </command_interface>
        <state_interface name="position" />
        <param name="solenoid_channel">1</param>
    </joint>
    
    <!-- pinky -->
    <joint name="lh_solenoid_5">
        <command_interface name="position">
            <param name="min">${solenoid_min}</param>
            <param name="max">${solenoid_max}</param>
        </command_interface>
        <state_interface name="position" />
        <param name="solenoid_channel">0</param>
    </joint>
</robot>